{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/lib/**/*.ts",
    "src/components/common/**/*.tsx",
    "src/components/pipeline/PipelineVisualization.tsx",
    "src/components/pipeline/IntentPanel.tsx",
    "src/components/pipeline/ContextPanel.tsx",
    "src/components/pipeline/PlannerPanel.tsx",
    "src/components/pipeline/ReasoningPanel.tsx",
    "src/components/pipeline/index.ts",
    "src/pages/ExecutionPage.tsx",
    "src/services/api.ts",
    "src/services/agentPipeline.ts",
    "src/store/**/*.ts",
    "src/types/index.ts",
    "src/vite-env.d.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
